{
  "name": "stash",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "eslint . --fix && prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm test:e2e",
    "devtools": "tsx packages/devtools/src/cli.ts"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.3",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm-mock-server": "0.2.2-rc.3",
    "@deepseek-ai/dsh-sdk-client": "0.2.2-rc.3",
    "@deepseek-ai/dsh-typert-generator": "0.2.2-rc.3",
    "@eslint/js": "^9.39.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/react": "^16.3.0",
    "@tsdown/css": "0.22.2",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/semver": "^7.7.0",
    "clsx": "2.1.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.8.0",
    "tsdown": "0.22.2",
    "tsx": "^4.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "4.1.11"
  }
}
